# -------------------------------------------------------------
# SGATAR 2026 Transport Planner — environment variables template
# Copy to .env.staging or .env (production) and fill in values.
# NEVER commit .env or .env.staging to git.
# -------------------------------------------------------------

# -- Server ----------------------------------------------------
# Airbase injects PORT automatically — do not change this value
PORT=8080
NODE_ENV=production

# -- Database --------------------------------------------------
# Neon Postgres pooled connection string
# Get from: neon.tech ? your project ? Connection Details ? Pooled connection
DATABASE_URL=postgresql://user:password@ep-xxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# -- Authentication passcodes ----------------------------------
# Passcode for Liaison Officer portal (/lo)
LO_PASSCODE=change-me-lo

# Passcode for Admin / Control Room portal (/admin)
ADMIN_PASSCODE=change-me-admin

# -- Public variables (safe to expose to the browser) ----------
# WhatsApp group invite link shown to delegates on the public page
NEXT_PUBLIC_WHATSAPP_INVITE_URL=https://chat.whatsapp.com/your-group-invite-link
